{{- $codeMeta := (partial "metadata/codemeta/codemeta.json" .)  | transform.Unmarshal (dict "format" "json")  -}}
{{- if reflect.IsMap $codeMeta -}}
  {{- with .OutputFormats.Get "codemeta" -}}
    {{- $codeMeta = merge $codeMeta (dict "@id" .Permalink) -}}
  {{- end -}}
  {{- $codeMeta | jsonify -}}
{{- end -}}
