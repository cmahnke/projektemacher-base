{{- $page := . -}}
{{- $codemetaURISuffix := "#codemeta" -}}

{{ $opts := dict
  "headers" (dict "Accept" "*/*")
}}

{{- $codemetaURL := $page.Params.codemeta | default "" -}}
{{- $remoteOK := false -}}
{{- $remoteContent := "" -}}
{{- $isURL := and (eq (printf "%T" $codemetaURL) "string") (hasPrefix $codemetaURL "http") -}}

{{- if $isURL -}}
  {{- with try (resources.GetRemote $codemetaURL $opts) -}}
    {{- with .Err -}}
      {{- errorf "[metadata/codemeta/codemeta.json] Can't get codemeta URL %s: %s" $codemetaURL . -}}
    {{ else with .Value }}
      {{- $remoteContent = .Content -}}
      {{- $remoteOK = true -}}
    {{- end -}}
  {{- end -}}
{{- else if $codemetaURL -}}
  {{- errorf "[metadata/codemeta/codemeta.json] codemeta field is not a URL: %s at %s" $codemetaURL $page.RelPermalink -}}
{{- end -}}

{{- if $remoteOK -}}
  {{- $remoteMeta := dict -}}
  {{- with try ($remoteContent | transform.Unmarshal) -}}
    {{- with .Err -}}
      {{- errorf "[metadata/codemeta/codemeta.json] codemeta URL %s returned invalid JSON: %s" $codemetaURL .Err -}}
    {{ else with .Value }}
      {{- $remoteMeta = . -}}
    {{- end -}}
  {{- end -}}
  {{- $ctxStrings := slice -}}
  {{- with index $remoteMeta "@context" -}}
    {{- if eq (printf "%T" .) "string" -}}
      {{- $ctxStrings = slice . -}}
    {{- else if reflect.IsSlice . -}}
      {{- range $ctxItem := . -}}
        {{- if eq (printf "%T" $ctxItem) "string" -}}
          {{- $ctxStrings = $ctxStrings | append $ctxItem -}}
        {{- else if reflect.IsMap $ctxItem -}}
          {{- with index $ctxItem "codemeta" -}}
            {{- $ctxStrings = $ctxStrings | append . -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $major := 0 -}}
  {{- range $ctxString := $ctxStrings -}}
    {{- $matches := findRESubmatch `w3id\.org/codemeta/(\d+)` $ctxString -}}
    {{- with $matches -}}
      {{- $major = int (index (index . 0) 1) -}}
    {{- end -}}
  {{- end -}}
  {{- if lt $major 2 -}}
    {{- errorf "[metadata/codemeta/codemeta.json] codemeta at %s: unsupported or missing version (need >= 2)" $codemetaURL -}}
  {{- else -}}
    {{- $remoteContent -}}
  {{- end -}}
{{- else -}}

{{- $cffFile := "CITATION.cff" -}}
{{- $explicitCff := isset .Params "cfffile" -}}
{{- with .Params.cfffile -}}
  {{- $cffFile = . -}}
{{- end -}}


{{- $cff := dict -}}

{{- if hasPrefix $cffFile "http" -}}
  {{- with try (resources.GetRemote $cffFile $opts) -}}
    {{- with .Err -}}
      {{- errorf "[metadata/codemeta/codemeta.json] Can't get CITATION.cff item %s: %s" $cffFile .Err -}}
    {{ else with .Value }}
      {{- $cff = . | transform.Unmarshal (dict "format" "yaml") -}}
    {{- end -}}
  {{- end -}}
{{- else -}}
  {{- with .Resources.Get $cffFile -}}
    {{- $cff = . | transform.Unmarshal (dict "format" "yaml") -}}
  {{- end -}}
{{- end -}}

{{- if $cff -}}
  {{- $codemeta := dict -}}
  {{- $authors := slice -}} 
    {{- range $cff.authors -}} 
      {{- $givenName := index . "given-names" -}}
      {{- $familyName := index . "family-names" -}}
      {{- $a := dict "@type" "Person" "givenName" $givenName "familyName" $familyName -}} 
      {{- with index . "orcid" -}}
        {{- $a = merge $a (dict "@id" .) -}}
      {{- end -}} 
      {{- with index . "affiliation" -}}
        {{- $a = merge $a (dict "affiliation" (dict "@type" "Organization" "name" .)) -}}
      {{- end -}} 
      {{- $authors = $authors | append $a -}} 
    {{- end -}} 
    {{- $codemeta = dict
      "@context" "https://w3id.org/codemeta/3.1"
      "@type" "SoftwareSourceCode"
      "name" $cff.title
      "description" ($cff.abstract | default "")
      "author" $authors
      "license" (printf "https://spdx.org/licenses/%s" $cff.license)
      "codeRepository" (index $cff "repository-code" | default "")
      "runtimePlatform" (index $cff "repository" | default "")
    -}}
    {{- with $cff.version -}}
      {{- $codemeta = merge $codemeta (dict "softwareVersion" .) -}}
    {{- end -}}
    {{- with index $cff "date-released" -}}
      {{- $datePublished := . -}}
      {{- if eq (printf "%T" .) "time.Time" -}}
        {{- $datePublished = dateFormat "2006-01-02" . -}}
      {{- end -}}
      {{- $codemeta = merge $codemeta (dict "datePublished" $datePublished) -}}
    {{- end -}}
    {{- with $cff.keywords -}}
      {{- $codemeta = merge $codemeta (dict "keywords" .) -}}
    {{- end -}} 
    {{- if index $cff "identifiers" -}} 
      {{- $ids := slice -}} 
      {{- range $cff.identifiers -}} 
        {{- $ids = $ids | append (dict "@type" "PropertyValue" "propertyID" .type "value" .value) -}} 
      {{- end -}} 
      {{- $codemeta = merge $codemeta (dict "identifier" $ids) -}}
    {{- end -}}
  {{- $codemeta | jsonify -}}
{{- else if $explicitCff -}}
  {{- errorf "[metadata/codemeta.json] %s not found at %s" $cffFile .RelPermalink -}}
{{- end -}}
{{- end -}}
