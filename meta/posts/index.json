[{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/tags/Another-tag/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/tags/Another-tag/index.xml"}],"path":"/tags/another-tag","section":["/tags"],"summary":"","title":"Another Tag","url":"https://cmahnke.github.io/projektemacher-base/tags/Another-tag/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/categories/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/categories/index.xml"}],"path":"/categories","section":[],"summary":"","title":"Categories","url":"https://cmahnke.github.io/projektemacher-base/categories/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/config/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/config/index.xml"}],"path":"/config","section":[],"summary":"","title":"Configs","url":"https://cmahnke.github.io/projektemacher-base/config/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/git/"}],"path":"/git","section":[],"summary":"\u003ch1 id=\"git-related-notes\"\u003eGit related notes\u003c/h1\u003e\n\u003ch1 id=\"fixing-wrong-github-user\"\u003eFixing wrong GitHub user\u003c/h1\u003e\n\u003cp\u003eMake sure the remote is configured with the right user name:\u003c/p\u003e\n\u003cpre tabindex=\"0\"\u003e\u003ccode\u003egit remote set-url origin https://cmahnke@github.com/cmahnke/hugo-13878.git\n\u003c/code\u003e\u003c/pre\u003e\u003ch1 id=\"setting-the-mail-address-for-a-push\"\u003eSetting the mail address for a push\u003c/h1\u003e\n\u003cpre tabindex=\"0\"\u003e\u003ccode\u003egit config user.email 194820+cmahnke@users.noreply.github.com\n\u003c/code\u003e\u003c/pre\u003e\u003ch1 id=\"populating-a-git-repository-for-github-error-reports\"\u003ePopulating a Git Repository for GitHub error reports\u003c/h1\u003e\n\u003cpre tabindex=\"0\"\u003e\u003ccode\u003egit remote add hugo-github-issue-13878 https://github.com/jmooring/hugo-testing\ngit fetch hugo-github-issue-13878 hugo-github-issue-13878\ngit checkout -B main\ngit merge hugo-github-issue-13878/hugo-github-issue-13878\ngit push --set-upstream origin main\n\u003c/code\u003e\u003c/pre\u003e","title":"Git","url":"https://cmahnke.github.io/projektemacher-base/git/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/i18n/"}],"path":"/i18n","section":[],"summary":"\u003ch1 id=\"i18n-strings\"\u003ei18n strings\u003c/h1\u003e\n\u003cp\u003eThis page lists all strings from the theme\u0026rsquo;s \u003ccode\u003ei18n/\u003c/code\u003e directory, grouped by language. It is generated at build time from the theme\u0026rsquo;s translation files — when a new translation or language is added, it shows up here automatically, no page changes needed.\u003c/p\u003e\n\u003ch2 id=\"how-the-themes-i18n-files-work\"\u003eHow the theme\u0026rsquo;s i18n files work\u003c/h2\u003e\n\u003cp\u003eTranslations live in the theme\u0026rsquo;s \u003ccode\u003ei18n/\u003c/code\u003e directory. Hugo loads files named \u003ccode\u003e\u0026lt;lang\u0026gt;.toml\u003c/code\u003e as the translation catalog for that language. For larger translation sets the strings can be split into fragments named \u003ccode\u003e\u0026lt;id\u0026gt;.\u0026lt;lang\u0026gt;.toml\u003c/code\u003e (for example \u003ccode\u003etags.de.toml\u003c/code\u003e or \u003ccode\u003eiiif.en.toml\u003c/code\u003e), which get merged into the main \u003ccode\u003e\u0026lt;lang\u0026gt;.toml\u003c/code\u003e files by the \u003ca href=\"https://github.com/cmahnke/projektemacher-base/blob/main/scripts/init/i18n.sh\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e\u003ccode\u003escripts/init/i18n.sh\u003c/code\u003e\u003c/a\u003e script. Note that the merged files are generated (gitignored), while the fragments are tracked in git.\u003c/p\u003e","title":"i18n strings","url":"https://cmahnke.github.io/projektemacher-base/i18n/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/de/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/de/index.xml"}],"path":"/de","section":[],"summary":"\u003ch1 id=\"einführung\"\u003eEinführung\u003c/h1\u003e\n\u003cp\u003eDeutsche Beispielseite. Diese Sprache dient als Testfall für mehrsprachige Builds des Themes, sie enthält nur diese Startseite.\u003c/p\u003e","title":"Projektemacher Base Vorlage","url":"https://cmahnke.github.io/projektemacher-base/de/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/tags/Some-Tag/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/tags/Some-Tag/index.xml"}],"path":"/tags/some-tag","section":["/tags"],"summary":"","title":"Some Tag","url":"https://cmahnke.github.io/projektemacher-base/tags/Some-Tag/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-1/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-1/index.xml"}],"path":"/tags/tag-1","section":["/tags"],"summary":"","title":"Tag 1","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-1/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-2/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-2/index.xml"}],"path":"/tags/tag-2","section":["/tags"],"summary":"","title":"Tag 2","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-2/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-3/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-3/index.xml"}],"path":"/tags/tag-3","section":["/tags"],"summary":"","title":"Tag 3","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-3/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-4/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-4/index.xml"}],"path":"/tags/tag-4","section":["/tags"],"summary":"","title":"Tag 4","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-4/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-with-hyphen/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-with-hyphen/index.xml"}],"path":"/tags/tag-with-hyphen","section":["/tags"],"summary":"","title":"Tag-With-Hyphen","url":"https://cmahnke.github.io/projektemacher-base/tags/Tag-with-hyphen/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/tags/"},{"name":"rss","url":"https://cmahnke.github.io/projektemacher-base/tags/index.xml"}],"path":"/tags","section":[],"summary":"","title":"Tags","url":"https://cmahnke.github.io/projektemacher-base/tags/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/shortcodes/demo/tagcloud/tags1/"}],"path":"/shortcodes/demo/tagcloud/tags1","section":["/shortcodes","/shortcodes/demo","/shortcodes/demo/tagcloud"],"summary":"","tags":["Tag 1","Some Tag","Tag-with-hyphen"],"title":"Tags 1","url":"https://cmahnke.github.io/projektemacher-base/shortcodes/demo/tagcloud/tags1/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/shortcodes/demo/tagcloud/tags2/"}],"path":"/shortcodes/demo/tagcloud/tags2","section":["/shortcodes","/shortcodes/demo","/shortcodes/demo/tagcloud"],"summary":"","tags":["Tag 2","Some Tag","Another tag","Tag-with-hyphen"],"title":"Tags 2","url":"https://cmahnke.github.io/projektemacher-base/shortcodes/demo/tagcloud/tags2/"},{"lang":"en","outputs":[{"name":"html","url":"https://cmahnke.github.io/projektemacher-base/shortcodes/demo/tagcloud/tags3/"}],"path":"/shortcodes/demo/tagcloud/tags3","section":["/shortcodes","/shortcodes/demo","/shortcodes/demo/tagcloud"],"sum