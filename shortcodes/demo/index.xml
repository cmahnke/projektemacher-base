				<description>&lt;h1 id=&#34;example&#34;&gt;Example&lt;/h1&gt;&#xA;&lt;div class=&#34;highlight-container&#34; id=&#34;container_d03296d263c7b757a69e1d0eb7d40f6a&#34;&gt;&#xA;  &lt;div class=&#34;highlight-head&#34;&gt;&#xA;    &lt;span class=&#34;highlight-title&#34;&gt;Example with title&lt;/span&gt;&#xA;    &lt;i class=&#34;copy&#34; id=&#34;button_d03296d263c7b757a69e1d0eb7d40f6a&#34; role=&#34;button&#34; tabindex=&#34;0&#34; aria-label=&#34;Copy code to clipboard&#34;&gt;&lt;/i&gt;&#xA;    &lt;label class=&#34;collapse&#34; for=&#34;collapse_d03296d263c7b757a69e1d0eb7d40f6a&#34;&gt;&lt;/label&gt;&#xA;  &lt;/div&gt;&#xA;  &lt;input type=&#34;checkbox&#34; style=&#34;position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);border:0;opacity:0;&#34; name=&#34;collapse_d03296d263c7b757a69e1d0eb7d40f6a&#34; id=&#34;collapse_d03296d263c7b757a69e1d0eb7d40f6a&#34; aria-label=&#34;Collapse code block&#34;&gt;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-js&#34; data-lang=&#34;js&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34; id=&#34;1&#34;&gt;&lt;a style=&#34;outline:none;text-decoration:none;color:inherit&#34; href=&#34;#1&#34;&gt;1&lt;/a&gt;&lt;/span&gt;&lt;span&gt;&lt;span style=&#34;color:#a6e22e&#34;&gt;navigator&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;clipboard&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;writeText&lt;/span&gt;(...)&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;textarea id=&#34;content_d03296d263c7b757a69e1d0eb7d40f6a&#34; style=&#34;display:none;&#34;&gt;navigator.clipboard.writeText(...)&#xA;&lt;/textarea&gt;&#xA;  &lt;script type=&#34;text/javascript&#34;&gt;&#xA;      var button = document.getElementById(&#39;button_d03296d263c7b757a69e1d0eb7d40f6a&#39;);&#xA;      var content = document.getElementById(&#39;content_d03296d263c7b757a69e1d0eb7d40f6a&#39;);&#xA;      document.addEventListener(&#39;DOMContentLoaded&#39;, function() {&#xA;        addCopyToClipboard(button, content);&#xA;      });&#xA;      button.addEventListener(&#39;keydown&#39;, function(event) {&#xA;        if (event.key === &#39;Enter&#39; || event.key === &#39; &#39;) {&#xA;          event.preventDefault();&#xA;          button.click();&#xA;        }&#xA;      });&#xA;  &lt;/script&gt;&#xA;&lt;/div&gt;&#xA;&lt;div class=&#34;highlight-container&#34; id=&#34;container_9591d73f0a7ce87c7e2f922e0280898e&#34;&gt;&#xA;  &lt;div class=&#34;highlight-head&#34;&gt;&#xA;    &lt;span class=&#34;highlight-title&#34;&gt;Example without line numbers&lt;/span&gt;&#xA;    &lt;i class=&#34;copy&#34; id=&#34;button_9591d73f0a7ce87c7e2f922e0280898e&#34; role=&#34;button&#34; tabindex=&#34;0&#34; aria-label=&#34;Copy code to clipboard&#34;&gt;&lt;/i&gt;&#xA;    &lt;label class=&#34;collapse&#34; for=&#34;collapse_9591d73f0a7ce87c7e2f922e0280898e&#34;&gt;&lt;/label&gt;&#xA;  &lt;/div&gt;&#xA;  &lt;input type=&#34;checkbox&#34; style=&#34;position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);border:0;opacity:0;&#34; name=&#34;collapse_9591d73f0a7ce87c7e2f922e0280898e&#34; id=&#34;collapse_9591d73f0a7ce87c7e2f922e0280898e&#34; aria-label=&#34;Collapse code block&#34;&gt;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-js&#34; data-lang=&#34;js&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&lt;span style=&#34;color:#a6e22e&#34;&gt;navigator&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;clipboard&lt;/span&gt;.&lt;span style=&#34;color:#a6e22e&#34;&gt;writeText&lt;/span&gt;(...)&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;textarea id=&#34;content_9591d73f0a7ce87c7e2f922e0280898e&#34; style=&#34;display:none;&#34;&gt;navigator.clipboard.writeText(...)&#xA;&lt;/textarea&gt;&#xA;  &lt;script type=&#34;text/javascript&#34;&gt;&#xA;      var button = document.getElementById(&#39;button_9591d73f0a7ce87c7e2f922e0280898e&#39;);&#xA;      var content = document.getElementById(&#39;content_9591d73f0a7ce87c7e2f922e0280898e&#39;);&#xA;      document.addEventListener(&#39;DOMContentLoaded&#39;, function() {&#xA;        addCopyToClipboard(button, content);&#xA;      });&#xA;      button.addEventListener(&#39;keydown&#39;, function(event) {&#xA;        if (event.key === &#39;Enter&#39; || event.key === &#39; &#39;) {&#xA;          event.preventDefault();&#xA;          button.click();&#xA;        }&#xA;      });&#xA;  &lt;/script&gt;&#xA;&lt;/div&gt;&#xA;&lt;h1 id=&#34;options&#34;&gt;Options&lt;/h1&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;code&gt;lang&lt;/code&gt; - string: One of those &lt;a href=&#34;https://gohugo.io/content-management/syntax-highlighting/#languages&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;supported languages&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;class&lt;/code&gt; - string: Custom class name&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;title&lt;/code&gt; - string: Custom title&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;lineNumbers&lt;/code&gt; - boolean: If line numbers should be shown, default: &lt;code&gt;true&lt;/code&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;code&gt;lineNumbersIDPrefix&lt;/code&gt; - string: Refix for the lin number id&amp;rsquo;s&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h1 id=&#34;references&#34;&gt;References&lt;/h1&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://gohugo.io/functions/transform/highlight/&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;transform.Highlight&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://gohugo.io/render-hooks/code-blocks/&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;Code block render hooks&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;</description>
